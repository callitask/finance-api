# /**
#  * AI-CONTEXT:
#  *
#  * Purpose:
#  * - Example environment variables for local development setup.
#  *
#  * Scope:
#  * - Used as a template to generate real `.env` files.
#  *
#  * Critical Dependencies:
#  * - N/A
#  *
#  * Security Constraints:
#  * - Must NEVER contain real passwords, tokens, or brand-identifiable default secrets that might be copy-pasted into prod.
#  *
#  * IMMUTABLE CHANGE HISTORY (DO NOT DELETE):
#  * - EDITED:
#  * • Replaced identifiable placeholders (e.g. `treishvaam_storage_secret`) with generic randomized strings.
#  * • Why: To satisfy CVE-010 and prevent accidental leak of production-adjacent credentials.
#  */

# ===================================================================
# LOCAL DEVELOPMENT SECRETS (TEMPLATE)
# Rename this file to .env or add these to your IDE Run Configuration.
# DO NOT COMMIT REAL VALUES TO GIT.
# ===================================================================

# --- Database ---
DEV_DB_PASSWORD=random_db_pass_xyz

# --- Security ---
DEV_INTERNAL_SECRET=random_internal_secret_abc
DEV_JWT_SECRET=your-super-secret-key-that-is-long-and-random

# --- MinIO (Storage) ---
DEV_MINIO_ACCESS_KEY=admin
DEV_MINIO_SECRET_KEY=random_minio_secret_123

# --- External APIs ---
# Use 'demo' for free testing or your real keys for data
DEV_NEWSDATA_API_KEY=YOUR_DEV_NEWSDATA_API_KEY
DEV_FMP_API_KEY=demo
DEV_ALPHA_API_KEY=demo
DEV_FINNHUB_API_KEY=demo