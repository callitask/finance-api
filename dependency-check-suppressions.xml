<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <notes><![CDATA[
            Suppressing CVE-2025-7962 for entire Angus group.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            Suppressing CVE-2025-48924 for Commons group, and Compress false positives.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.commons/.*$</packageUrl>
        <cve>CVE-2025-48924</cve>
        <cve>CVE-2024-25710</cve>
        <cve>CVE-2024-26308</cve>
    </suppress>

    

    

    

    <suppress>
        <notes><![CDATA[
            Suppressing Swagger UI DOMPurify findings.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.webjars/swagger-ui@.*$</packageUrl>
        <cpe>cpe:/a:dompurify_project:dompurify</cpe>
    </suppress>

    
    
    
    
    

    

    

    

    <suppress>
        <notes><![CDATA[
            Kotlin Stdlib false positive
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib@.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            Log4j API false positive
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2025-68161</cve>
    </suppress>
</suppressions>