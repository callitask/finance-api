<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="V47-1" author="aegis-security">
        <addColumn tableName="analytics_events">
            <column name="device_fingerprint" type="VARCHAR(64)"/>
        </addColumn>
        <addColumn tableName="audience_visits">
            <column name="device_fingerprint" type="VARCHAR(64)"/>
            <column name="device_brand" type="VARCHAR(100)"/>
            <column name="device_class" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <changeSet id="V47-2" author="aegis-security">
        <createIndex tableName="analytics_events" indexName="idx_analytics_fingerprint">
            <column name="device_fingerprint"/>
        </createIndex>
        <createIndex tableName="audience_visits" indexName="idx_audience_fingerprint">
            <column name="device_fingerprint"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>