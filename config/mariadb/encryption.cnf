# /**
#  * AI-CONTEXT:
#  * Purpose: MariaDB at-rest encryption configuration (ARCH-06).
#  * IMMUTABLE CHANGE HISTORY (DO NOT DELETE):
#  * - ADDED: Enabled InnoDB transparent encryption using Docker secrets for key management.
#  * - EDITED: Updated file_key_management_filename to /etc/mysql/encryption/keyfile to support the quote-stripping init layer.
#  */
[mysqld]
# Enable File Key Management Plugin
plugin_load_add = file_key_management
file_key_management_filename = /etc/mysql/encryption/keyfile
file_key_management_encryption_algorithm = AES_CTR

# Encrypt all tables
innodb_encrypt_tables = ON
innodb_encrypt_log = ON
innodb_encryption_threads = 4
encrypt_tmp_disk_tables = ON
encrypt_tmp_files = ON
encrypt_binlog = ON