# /**
#  * AI-CONTEXT:
#  *
#  * Purpose:
#  * - MariaDB server configuration for the Treishvaam backend.
#  * - Enables binary logging for Point-in-Time Recovery (PITR) capability.
#  *
#  * Scope:
#  * - Responsible for: enabling binlog, setting binlog format, retention policy, query profiling.
#  * - Must NEVER be responsible for: application-level config, credentials.
#  *
#  * Critical Dependencies:
#  * - docker-compose.yml mounts this file to /etc/mysql/conf.d/my.cnf inside treishvaam-db.
#  * - MariaDB service must be restarted after this file changes for settings to take effect.
#  *
#  * Security Constraints:
#  * - No credentials in this file. All auth via MYSQL_ROOT_PASSWORD env var in docker-compose.
#  *
#  * Non-Negotiables:
#  * - binlog_format=ROW is required for PITR — STATEMENT format is unsafe for non-deterministic queries.
#  * - expire_logs_days=7 prevents unbounded disk growth on the Ubuntu VM.
#  * - Do NOT set expire_logs_days=0 (never expire) — the VM has limited disk space.
#  *
#  * Change Intent:
#  * - P2-4: Enable MariaDB binary logging for Point-in-Time Recovery capability.
#  * Without binlog, the only recovery option after data corruption is a full dump restore
#  * (losing all changes since the last backup). With binlog, recovery is possible to any
#  * specific transaction within the retention window.
#  *
#  * Future AI Guidance:
#  * - Do NOT disable log_bin without confirming a replacement PITR strategy exists.
#  * - If migrating to MariaDB 10.11+, verify expire_logs_days is still the correct directive
#  * (10.11 uses binlog_expire_logs_seconds instead).
#  * - Do NOT increase expire_logs_days beyond 14 without verifying available disk space on the VM.
#  *
#  * IMMUTABLE CHANGE HISTORY (DO NOT DELETE):
#  * - ADDED (2026-05-14 P2-4 Fix):
#  * • Created config/mariadb/my.cnf with binary logging enabled.
#  * • log_bin=mysql-bin, binlog_format=ROW, expire_logs_days=7.
#  * • Why: Audit Report P2-4 requirement. Without binlog, point-in-time recovery is impossible.
#  * A ransomware attack or accidental DELETE with no binlog = full data loss since last backup.
#  * • docker-compose.yml already mounts ./config/mariadb:/etc/mysql/conf.d — no compose change needed.
#  *
#  * - EDITED (Phase 4):
#  * • Added slow_query_log and related parameters.
#  * • Why: Required for enterprise observability to identify missing indexes and database bottlenecks.
#  */

[mysqld]
# ===================================================================
# BINARY LOGGING — Point-in-Time Recovery (PITR)
# P2-4 Fix: Required for recovery to any specific transaction.
# ===================================================================

# Enable binary logging. mysql-bin is the log file prefix.
log_bin = mysql-bin

# ROW format: logs the actual row changes (not SQL statements).
# Required for PITR with non-deterministic queries (NOW(), UUID(), etc.).
# STATEMENT format is unsafe for replication and PITR with these functions.
binlog_format = ROW

# Retain binary logs for 7 days. Prevents unbounded disk growth.
# Adjust based on available disk space and backup frequency.
# If nightly backups run, 7 days provides 6 days of PITR window beyond the last backup.
expire_logs_days = 7

# Maximum size per binary log file before rotation (256MB).
max_binlog_size = 268435456

# ===================================================================
# OBSERVABILITY — Slow Query Logging (Phase 4)
# ===================================================================

slow_query_log = 1
slow_query_log_file = /var/lib/mysql/mariadb-slow.log
long_query_time = 2.0
log_queries_not_using_indexes = 1
# Limit verbosity of non-indexed queries to prevent disk saturation
log_throttle_queries_not_using_indexes = 10